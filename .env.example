POSTGRES_DB=applypilot
POSTGRES_USER=applypilot
POSTGRES_PASSWORD=replace-with-a-unique-local-password
DATABASE_URL=jdbc:postgresql://localhost:5433/applypilot
REDIS_HOST=localhost
REDIS_PORT=6379
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30
APP_ORIGIN=http://localhost:5174
APP_RATE_LIMIT_AUTH_MAX=20
APP_RATE_LIMIT_IMPORT_MAX=30
APP_RATE_LIMIT_AI_MAX=10
APP_RATE_LIMIT_WINDOW_SECONDS=60
REDIS_CONNECT_TIMEOUT=2s
REDIS_COMMAND_TIMEOUT=2s
DB_CONNECTION_TIMEOUT_MS=3000
DB_VALIDATION_TIMEOUT_MS=1000
APP_WORKER_CONNECT_TIMEOUT_SECONDS=3
APP_WORKER_REQUEST_TIMEOUT_SECONDS=45
VITE_API_URL=http://localhost:8081/api
UPLOAD_DIR=./data/uploads
LLM_PROVIDER=none
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:3b
LLM_TIMEOUT_MS=30000
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
