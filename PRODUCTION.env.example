# Copy to a private .env.production on the deployment host. Do not commit secrets.
APPLYPILOT_DOMAIN=applypilot.example.com
ACME_EMAIL=ops@example.com
APPLYPILOT_SECRETS_DIR=./secrets

# Replace each value with a verified immutable image reference including @sha256 digest.
APPLYPILOT_CADDY_IMAGE=
APPLYPILOT_POSTGRES_IMAGE=
APPLYPILOT_REDIS_IMAGE=
APPLYPILOT_API_IMAGE=
APPLYPILOT_WEB_IMAGE=
APPLYPILOT_WORKER_IMAGE=

POSTGRES_DB=applypilot
POSTGRES_USER=applypilot
APP_RATE_LIMIT_AUTH_MAX=20
APP_RATE_LIMIT_IMPORT_MAX=30
APP_RATE_LIMIT_AI_MAX=10
APP_RATE_LIMIT_WINDOW_SECONDS=60
SPRING_MAIL_HOST=smtp.example.com
SPRING_MAIL_PORT=587
